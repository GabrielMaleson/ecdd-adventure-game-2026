  m_EditorClassIdentifier: Assembly-CSharp::BarkConversation
  lines:
  - speakerId: haze
    text: It opened!
    gapAfter: 0
    aoMesmoTempoQueAnterior: 0
  - speakerId: josh
    text: Are you that excited to go in there?
    gapAfter: 0
    aoMesmoTempoQueAnterior: 0
  - speakerId: marcus
    text: Damn, our boy Josh's got the sauce.
    gapAfter: 0
    aoMesmoTempoQueAnterior: 0
  - speakerId: erika
    text: "Yeah, I don't know how you did that, but\u2026nice."
    gapAfter: 0
    aoMesmoTempoQueAnterior: 0
  - speakerId: josh
    text: "Thanks guys\u2026let's go."
    gapAfter: 0
    aoMesmoTempoQueAnterior: 0
